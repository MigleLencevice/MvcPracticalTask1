@model MvcPracticalTask.Models.Film

<h2>Edit Film</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-2">
        <label asp-for="FilmID"></label>
        <input asp-for="FilmID" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="DirectorID"></label>
        <input asp-for="DirectorID" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="RunTimeMinutes"></label>
        <input asp-for="RunTimeMinutes" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="BudgetDollars"></label>
        <input asp-for="BudgetDollars" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="BoxOfficeDollars"></label>
        <input asp-for="BoxOfficeDollars" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="OscarNominations"></label>
        <input asp-for="OscarNominations" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="OscarWins"></label>
        <input asp-for="OscarWins" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Review"></label>
        <textarea asp-for="Review" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-warning">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>